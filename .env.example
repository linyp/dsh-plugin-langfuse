# Langfuse cloud credentials for the key-gated e2e (tests/langfuse-cloud.e2e.ts).
# Copy to .env (gitignored) and fill in from your Langfuse project settings.
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
# Region host: EU https://cloud.langfuse.com | US https://us.cloud.langfuse.com
LANGFUSE_HOST=https://us.cloud.langfuse.com
