{
  "name": "dsh-plugin-langfuse",
  "version": "0.5.0",
  "description": "Langfuse observability for DeepSeek Harness: OpenTelemetry traces, compaction, feedback Scores, and fork lineage",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md"
  ],
  "license": "MIT",
  "author": "Yupeng Lin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linyp/dsh-plugin-langfuse.git"
  },
  "homepage": "https://github.com/linyp/dsh-plugin-langfuse#readme",
  "bugs": "https://github.com/linyp/dsh-plugin-langfuse/issues",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "langfuse",
    "opentelemetry",
    "observability",
    "llm-tracing"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": "^22.19 || >=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:package": "node .github/scripts/test-package.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh-command-feedback": "0.1.0-rc.8",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.8",
    "@deepseek-ai/dsh-session": "0.1.0-rc.8",
    "@deepseek-ai/dsh-session-telemetry": "0.1.0-rc.8",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/otlp-exporter-base": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.2",
    "@deepseek-ai/cordis-plugin-logger-console": "^1.0.1",
    "@deepseek-ai/dsh-agent-spine-demo": "0.1.0-rc.8",
    "@deepseek-ai/dsh-app-boot": "0.1.0-rc.8",
    "@deepseek-ai/dsh-bash-local": "0.1.0-rc.8",
    "@deepseek-ai/dsh-loader-smoke": "0.1.0-rc.8",
    "@deepseek-ai/dsh-session-checkpoint-policy": "0.1.0-rc.8",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.1.0-rc.8",
    "@deepseek-ai/dsh-subprocess-local": "0.1.0-rc.8",
    "@types/node": "^24.13.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
